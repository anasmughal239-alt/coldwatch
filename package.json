{
  "name": "coldwatch",
  "version": "0.1.0",
  "description": "Deliverability infrastructure health checks for cold-email sending domains (SPF, DMARC, DKIM, MX).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anasmughal239-alt/coldwatch.git"
  },
  "homepage": "https://github.com/anasmughal239-alt/coldwatch#readme",
  "bugs": {
    "url": "https://github.com/anasmughal239-alt/coldwatch/issues"
  },
  "type": "module",
  "bin": {
    "coldwatch": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && rm -rf dist && npm run build"
  },
  "keywords": [
    "cold-email",
    "deliverability",
    "spf",
    "dmarc",
    "dkim",
    "email-authentication",
    "dns",
    "email-deliverability",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "tldts": "^6.1.85"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
